# Copie este archivo como "app/.env" y ajuste los valores. El archivo .env NO se sube a Git.
# Si no crea el .env, se usan estos mismos valores por defecto.

# Instancia de SQL Server y base de datos
DB_SERVIDOR=localhost\SQLEXPRESS
DB_NOMBRE=TiendaTechDB
DB_DRIVER=ODBC Driver 18 for SQL Server

# --- Opción A (por defecto): autenticación de Windows ---
# La aplicación limita la sesión al usuario de base de datos app_tiendatech,
# que solo puede ejecutar procedimientos almacenados (ver sql/08_seguridad.sql).
DB_AUTENTICACION=windows
DB_EJECUTAR_COMO=app_tiendatech

# --- Opción B: autenticación de SQL Server con un inicio de sesión limitado ---
# DB_AUTENTICACION=sql
# DB_USUARIO=app_tiendatech_login
# DB_CONTRASENA=<escriba aquí la contraseña que definió al crear el login>
# DB_EJECUTAR_COMO=

# Clave para firmar las cookies de sesión. Genere una propia con:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Si la deja vacía se genera una nueva cada vez que arranca la aplicación.
SECRET_KEY=

PUERTO=5000
